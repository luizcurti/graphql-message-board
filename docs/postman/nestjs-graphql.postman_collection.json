    "name": "GraphQL Message Board API",
    "description": "GraphQL API collection for the GraphQL Message Board back-end (NestJS + TypeORM). Each query/mutation has one happy-path and one sad-path request. Run the whole collection top to bottom (folders in order) against a running backend — later requests depend on ids captured by earlier ones via environment variables (userId, messageId).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Stats",
      "item": [
        {
          "name": "Get stats (happy)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('no GraphQL errors', () => pm.expect(json.errors).to.be.undefined);",
                  "pm.test('users and messages are numbers', () => {",
                  "  pm.expect(json.data.getStats.users).to.be.a('number');",
                  "  pm.expect(json.data.getStats.messages).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"{ getStats { users messages } }\",\n  \"variables\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "description": "Happy path: returns the total user and message counts."
          },
          "response": []
        }
      ]
    },
